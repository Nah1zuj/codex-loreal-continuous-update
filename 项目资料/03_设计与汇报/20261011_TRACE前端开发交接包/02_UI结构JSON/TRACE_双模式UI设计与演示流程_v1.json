  "event_contract": {
    "status": "DECLARATIVE_UI_EVENTS_NOT_IMPLEMENTED_APIS",
    "select_voice": {
      "mode": "voice",
      "destination_page": "voice",
      "auto_start_microphone": false
    },
    "select_visual": {
      "mode": "visual",
      "destination_page": "explore"
    },
    "start_text": {
      "destination_page": "voice",
      "input_channel": "text",
      "auto_start_microphone": false,
      "auto_read": false
    },
    "activate_intro": {
      "requires": "user_gesture",
      "action": "optional_tts_intro"
    },
    "talk": {
      "requires": [
        "user_gesture",
        "browser_microphone_permission"
      ],
      "effects": [
        "cancel_current_tts",
        "start_single_utterance_capture"
      ]
    },
    "submit_text": {
      "handler": "existing_agent_send",
      "api_endpoint": null
    },
    "repeat": {
      "target": "current_instruction",
      "advance_step": false,
      "write_memory": false
    },
    "slow": {
      "target": "tts_speed_and_instruction_detail",
      "user_can_restore": true
    },
    "next": {
      "handler": "existing_state_machine_next",
      "advance_max_steps": 1
    },
    "why": {
      "handler": "explain_current_step_with_source_and_limits",
      "advance_step": false
    },
    "request_echo": {
      "destination_page": "camera",
      "requires": "separate_current_use_camera_consent"
    },
    "decline_camera": {
      "destination_page": "guide",
      "preserve_step": true
    },
    "capture": {
      "requires": [
        "current_use_camera_consent",
        "quality_gate_pass",
        "user_gesture"
      ],
      "frames": 3,
      "stop_stream_after_capture": true
    },
    "switch_mode": {
      "preserve_shared_state": true,
      "stop_active_media": true
    },
    "stop": {
      "effects": [
        "cancel_tts",
        "cancel_asr",
        "release_camera",
        "cancel_pending_ui_actions"
      ],
      "session_resume_policy": "CHECK_EXISTING_IMPLEMENTATION"
    },
    "save_memory": {
      "requires": "explicit_confirmation_of_exact_preference",
      "api_endpoint": null
    },
    "delete_memory": {
      "requires": "user_request",
      "api_endpoint": null
    }
  },
  "camera_contract": {
    "demonstration_task": "blush_presence",
    "allowed_statuses": [
      "NO_BLUSH",
      "LEFT_ONLY",
      "RIGHT_ONLY",
      "BOTH",
      "UNCERTAIN"
    ],
    "side_reference": "USER_LEFT_AND_RIGHT",
    "preview_mirroring_does_not_change_side_reference": true,
    "quality_checks": [
      "face_count",
      "pose",
      "occlusion",
      "lighting",
      "blur"
    ],
    "quality_checks_implemented": false,
    "capture_frames": 3,
    "frames_independent_evidence": false,
    "provider_name": null,
    "provider_model": null,
    "provider_capability_status": "NOT_TESTED",
    "confidence_is_calibrated_probability": false,
    "uncertain_copy_zh": "我现在还不能可靠判断。可以转正一点、调整光线后再试一次；也可以跳过检查。",
    "corrective_instruction_on_uncertain": false,
    "consent_copy_template_zh": "这次需要使用相机检查腮红状态。若使用远程模型，画面会发送给配置的服务提供商。你愿意继续吗？",
    "consent_copy_status": "UPDATE_TO_MATCH_ACTUAL_PROVIDER_AND_STORAGE_BEFORE_USE",
    "claims_excluded": [
      "连续实时动捕纠妆",
      "专业级颜色测量",
      "可靠的微小左右差异判断",
      "保证口红边界识别",
      "外貌评分"
    ],
    "mock_output_must_be_labeled": true
  },
  "accessibility_and_fallbacks": {
    "entry_requires_disability_disclosure": false,
    "infer_disability_from_voice_or_video": false,
    "identity_saved_as_health_label": false,
    "autoplay_on_load": false,
    "auto_mic_or_camera_on_load": false,
    "keyboard_operable": true,
    "semantic_headings": true,
    "visible_focus_required": true,
    "live_region_policy": "用户选择应用朗读；避免应用TTS与读屏重复播报，不依赖检测读屏软件。",
    "fallbacks": [
      {
        "trigger": "microphone_denied_or_asr_unavailable",
        "copy_zh": "可以使用文字输入继续。",
        "action": "show_text_input",
        "preserve_step": true
      },
      {
        "trigger": "tts_failed",
        "copy_zh": "语音暂时不可用，内容已显示在页面上。",
        "action": "keep_accessible_text",
        "preserve_step": true
      },
      {
