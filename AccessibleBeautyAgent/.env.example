MODEL_PROVIDER=mock
ALLOW_REMOTE_AI=false
REFERENCE_PROVIDER=mock
RESEARCH_MODE=false
ADMIN_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Set a vision-capable model independently when ready; blank blocks image calls.
DEEPSEEK_VISION_MODEL=
VISION_PROVIDER=mock
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=mock
VOICE_PROVIDER=browser
DEVELOPER_MODE=true
# Copy the OpenAI-compatible base URL from your regional Model Studio workspace.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
REMOTE_TIMEOUT=30
CONFIDENCE_HIGH=0.80
CONFIDENCE_MIN=0.60
# Local-only development. No image persistence.
MEMORY_PATH=data/users/beauty.sqlite
PRODUCT_SCENE_WEIGHT=3
PRODUCT_LOOK_WEIGHT=4
PRODUCT_FINISH_WEIGHT=2
PRODUCT_PREFERENCE_WEIGHT=2
PRODUCT_RISK_PENALTY=5

READING_PROVIDER=mock
